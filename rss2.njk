---
pagination:
  data: collections.blog.feeds
  size: 1
  alias: feed
permalink: "{{ feed.path | decodeURI }}/rss2"
eleventyAllowMissingExtension: true
---
<?xml version="1.0" encoding="utf-8"?><?xml-stylesheet title="XSL formatting" type="text/xsl" href="/feed/rss2.xsl" ?>
<rss version="2.0"
  xmlns:dc="http://purl.org/dc/elements/1.1/"
  xmlns:content="http://purl.org/rss/1.0/modules/content/"
  xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ site.name | xml | safe }}{{ feed.subtitle | xml | safe }}</title>
  <link>{{ site.url }}/</link>
  <atom:link href="{{ site.url }}{{ feed.path }}/rss2" rel="self" type="application/rss+xml"/>
  <description>{{ site.description | xml | safe }}</description>
  <language>{{ site.lang }}</language>
  <pubDate>{{ collections.blog.updatedRfc822 }}</pubDate>
  <copyright></copyright>
  <docs>http://blogs.law.harvard.edu/tech/rss</docs>
{% for p in feed.posts %}
  <item>
    <title>{{ p.title | xml | safe }}</title>
    <link>{{ p.absUrl }}</link>
    <guid isPermaLink="{{ "true" if p.guid == p.absUrl else "false" }}">{{ p.guid }}</guid>
    <pubDate>{{ p.rfc822 }}</pubDate>
    <dc:creator>{{ p.author | xml | safe }}</dc:creator>
    {% if p.category %}<category>{{ p.category.title | xml | safe }}</category>
    {% endif %}{% for t in p.tags %}<category>{{ t.name | xml | safe }}</category>{% endfor %}
    <description>{{ p.feedContent | xml | safe }}</description>
  </item>
{% endfor %}
</channel>
</rss>
