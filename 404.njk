{% extends "base.njk" %}
{% block robots %}NOINDEX, FOLLOW, NOARCHIVE{% endblock %}
{% block title %}Document not found - {{ site.name }}{% endblock %}
{% block head %}
  <link rel="top" href="/" title="Home" />
  <link rel="contents" href="/archive" title="Archives" />
  <link rel="alternate" type="application/atom+xml" title="Atom 1.0" href="/feed/atom" />
{% endblock %}
{% block bodyClass %}dc-404{% endblock %}
{% block content %}
  <div id="content-info">
    <h2>Document not found</h2>
  </div>

  <div class="content-inner">
    <p>The document you are looking for does not exist.</p>
  </div>
{% endblock %}
